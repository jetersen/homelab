# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
# AI-safe: agents may read this schema; secret values stay in .env.local or Proton Pass.
#
# @plugin(@varlock/proton-pass-plugin)
# @initProtonPass()
# @defaultRequired=false @defaultSensitive=false
# @generateTypes(lang=ts, path=env.d.ts)
# ----------

# Kubernetes context used for cluster operations in this repo.
# @type=string(minLength=1)
# @example="homelab"
KUBE_CONTEXT=homelab

# Repo-specific Talos config path for talosctl. Relative to repo root/current working directory.
# @sensitive
# @example="./kubernetes/talos/clusterconfig/talosconfig"
TALOSCONFIG=./kubernetes/talos/clusterconfig/talosconfig

# Proton Pass CLI login username. Optional if pass-cli is already logged in.
# @docs("Proton Pass plugin", https://varlock.dev/plugins/proton-pass/)
# @example="user@example.com"
PROTON_PASS_USERNAME=

# Proton Pass account password for non-interactive login.
# @type=protonPassPassword @sensitive
PROTON_PASS_PASSWORD=

# Proton Pass TOTP for non-interactive login.
# @type=protonPassTotp @sensitive
PROTON_PASS_TOTP=

# Proton Pass extra password, if enabled.
# @type=protonPassExtraPassword @sensitive
PROTON_PASS_EXTRA_PASSWORD=

# UniFi controller/base URL for read-only network inspection.
# Resolved from Proton Pass: pass://Personal/UniFi/Host
# @type=url
# @docs("UniFi Network API", https://developer.ui.com/)
# @example="https://unifi.example.com"
UNIFI_HOST=protonPass(pass://Personal/UniFi/Host, allowMissing=true)

# UniFi API token. Prefer a short-lived/site-scoped token.
# Resolved from Proton Pass: pass://Personal/UniFi/Token
# @sensitive
UNIFI_TOKEN=protonPass(pass://Personal/UniFi/Token, allowMissing=true)

# TrueNAS base URL from Proton Pass.
# @type=url
TRUENAS_HOST=protonPass(pass://Personal/TrueNAS/urls, allowMissing=true)

# TrueNAS API token from Proton Pass.
# @sensitive
TRUENAS_TOKEN=protonPass(pass://Personal/TrueNAS/password, allowMissing=true)

# IoT WiFi SSID to attach to VLAN 20.
IOT_WIFI_SSID="The Creep Nextdoor IoT"

# IoT WiFi WPA2 password stored in Proton Pass WiFi item.
# Resolved from Proton Pass: pass://Personal/The Creep Nextdoor IoT/password
# @sensitive
IOT_WIFI_PASSWORD=protonPass("pass://Personal/The Creep Nextdoor IoT/password", allowMissing=true)

# Technitium DNS admin URL from Proton Pass.
# Proton Pass item title is currently "Technitum".
# @type=url
TECHNITIUM_HOST=protonPass("pass://Personal/Technitum/urls", allowMissing=true)

# Technitium DNS admin username from Proton Pass.
TECHNITIUM_USERNAME=protonPass("pass://Personal/Technitum/username", allowMissing=true)

# Technitium DNS admin password from Proton Pass.
# @sensitive
TECHNITIUM_PASSWORD=protonPass("pass://Personal/Technitum/password", allowMissing=true)

# Home Assistant URL.
# @type=url
HOME_ASSISTANT_HOST=protonPass("pass://Personal/Home Assistant/host", allowMissing=true)

# Home Assistant long-lived access token from Proton Pass.
# @sensitive
# @docs("Home Assistant REST API", https://developers.home-assistant.io/docs/api/rest/)
HOME_ASSISTANT_TOKEN=protonPass("pass://Personal/Home Assistant/token", allowMissing=true)

# Towonel API URL.
# @type=url
TOWONEL_API_URL=https://hub.towonel.dev

# Towonel personal API key from Proton Pass.
# @sensitive
# @docs("Towonel REST API", https://console.towonel.dev/swagger-ui/)
TOWONEL_API_TOKEN=protonPass("pass://Personal/Towonel Hub/token", allowMissing=true)

# Towonel regional edge IP used for public DNS.
# @sensitive
TOWONEL_EDGE_IP=protonPass("pass://Personal/Towonel Hub/edge-ip", allowMissing=true)

# Set true locally once the OVHcloud bucket and both Proton Pass items exist.
# @type=boolean
BACKUP_S3_CONFIGURED=false

# Provisioned OVHcloud S3 backup bucket in Frankfurt.
# @example="jetersen-homelab-kopia"
# @required=eq($BACKUP_S3_CONFIGURED,true)
BACKUP_S3_BUCKET=jetersen-homelab-kopia

# Selected OVHcloud single-zone region: Frankfurt, Germany. Confirm against the bucket.
BACKUP_S3_REGION=de

# Kopia expects an endpoint hostname. The io endpoint uses Standard storage by default.
# @docs("OVHcloud S3 endpoints", https://github.com/ovh/docs/blob/develop/pages/storage_and_backup/object_storage/s3_location/guide.en-gb.md)
BACKUP_S3_ENDPOINT=s3.de.io.cloud.ovh.net

# Dedicated OVHcloud Object Storage user credentials supplied by the user in Proton Pass.
# @sensitive @required=eq($BACKUP_S3_CONFIGURED,true)
BACKUP_S3_ACCESS_KEY_ID=if(eq($BACKUP_S3_CONFIGURED,true), protonPass("pass://Personal/OVHcloud Homelab S3/username"), "")

# @sensitive @required=eq($BACKUP_S3_CONFIGURED,true)
BACKUP_S3_SECRET_ACCESS_KEY=if(eq($BACKUP_S3_CONFIGURED,true), protonPass("pass://Personal/OVHcloud Homelab S3/password"), "")

# Separate Kopia encryption password; retain this outside the cluster for recovery.
# @sensitive @required=eq($BACKUP_S3_CONFIGURED,true)
BACKUP_KOPIA_PASSWORD=if(eq($BACKUP_S3_CONFIGURED,true), protonPass("pass://Personal/Homelab Kopia/password"), "")

# Enable locally once the OVH API item and Pulumi passphrase item exist.
# This is independent of BACKUP_S3_CONFIGURED: Pulumi creates the S3 credentials.
# @type=boolean
BACKUP_IAC_CONFIGURED=false

# OVHcloud control-plane credentials, separate from the Kopia S3 credentials.
# @sensitive @required=eq($BACKUP_IAC_CONFIGURED,true)
OVH_APPLICATION_KEY=if(eq($BACKUP_IAC_CONFIGURED,true), protonPass("pass://Personal/OVHcloud Homelab API/application-key"), "")

# @sensitive @required=eq($BACKUP_IAC_CONFIGURED,true)
OVH_APPLICATION_SECRET=if(eq($BACKUP_IAC_CONFIGURED,true), protonPass("pass://Personal/OVHcloud Homelab API/application-secret"), "")

# @sensitive @required=eq($BACKUP_IAC_CONFIGURED,true)
OVH_CONSUMER_KEY=if(eq($BACKUP_IAC_CONFIGURED,true), protonPass("pass://Personal/OVHcloud Homelab API/consumer-key"), "")

# Use OVH state by default. Set false locally only for bootstrap or reviewed recovery.
# @type=boolean
PULUMI_STATE_CONFIGURED=true

# Encrypt Pulumi secret values in state; retain separately for recovery.
# Remote state commands need this even without the OVH control-plane credentials.
# @sensitive @required=if(eq($PULUMI_STATE_CONFIGURED,true),true,eq($BACKUP_IAC_CONFIGURED,true))
PULUMI_CONFIG_PASSPHRASE=if(eq($PULUMI_STATE_CONFIGURED,true), protonPass("pass://Personal/Homelab Pulumi/password"), if(eq($BACKUP_IAC_CONFIGURED,true), protonPass("pass://Personal/Homelab Pulumi/password"), ""))

# Dedicated versioned OVHcloud S3 state bucket, independent of Kopia.
PULUMI_STATE_BACKEND_URL=s3://jetersen-homelab-pulumi?endpoint=https://s3.de.io.cloud.ovh.net&region=de&s3ForcePathStyle=true&awssdk=v2

# Bootstrap against local state until the remote bucket and credentials exist.
PULUMI_BACKEND_URL=if(eq($PULUMI_STATE_CONFIGURED,true), $PULUMI_STATE_BACKEND_URL, "file://./.pulumi-state")

# Pulumi's S3 backend uses AWS SDK variables with the OVH endpoint above.
# These credentials must belong to the state user, separate from Kopia.
# @sensitive @required=eq($PULUMI_STATE_CONFIGURED,true)
AWS_ACCESS_KEY_ID=if(eq($PULUMI_STATE_CONFIGURED,true), protonPass("pass://Personal/OVHcloud Homelab Pulumi S3/username"), "")

# @sensitive @required=eq($PULUMI_STATE_CONFIGURED,true)
AWS_SECRET_ACCESS_KEY=if(eq($PULUMI_STATE_CONFIGURED,true), protonPass("pass://Personal/OVHcloud Homelab Pulumi S3/password"), "")
