{
  "filesystem.setperm": {
    "path": "/mnt/nvme/media",
    "uid": 568,
    "gid": 568,
    "mode": "775",
    "options": {
      "recursive": false,
      "stripacl": false
    }
  },
  "sharing.nfs.create": {
    "path": "/mnt/nvme/media",
