{
  "(global)": {
    "retention": {
      "keepLatest": 3,
      "keepHourly": 0,
      "keepDaily": 0,
      "keepWeekly": 0,
      "keepMonthly": 0,
      "keepAnnual": 0,
      "ignoreIdenticalSnapshots": false
    },
    "files": {
      "ignore": [
        "/*",
        "!/backups",
        "/backups/*",
        "!/backups/*.tar"
      ],
      "ignoreDotFiles": [
        ".kopiaignore"
      ]
    },
    "errorHandling": {
      "ignoreFileErrors": false,
      "ignoreDirectoryErrors": false,
      "ignoreUnknownTypes": false
    }
  }
}
