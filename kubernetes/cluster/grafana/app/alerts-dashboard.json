{
  "uid": "homelab-alerts",
  "title": "Homelab alerts",
  "tags": [
    "homelab",
    "alerts"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "title": "Alert rules",
      "type": "link",
      "url": "/alerting/list"
    },
    {
      "title": "Active notifications and silences",
      "type": "link",
      "url": "/alerting/notifications"
    },
    {
      "title": "Notification inbox",
      "type": "link",
      "url": "https://gotify.jetersen.dev"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": "label_values(ALERTS, namespace)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Firing alerts",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ALERTS{alertstate=\"firing\",namespace=~\"$namespace\",alertname!~\"Watchdog|InfoInhibitor\"}) or vector(0)",
          "legendFormat": "{{alertname}} \u00b7 {{namespace}} \u00b7 {{alertstate}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Pending alerts",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ALERTS{alertstate=\"pending\",namespace=~\"$namespace\"}) or vector(0)",
          "legendFormat": "{{alertname}} \u00b7 {{namespace}} \u00b7 {{alertstate}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Alert state history",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{namespace=~\"$namespace\",alertname!~\"Watchdog|InfoInhibitor\"}",
          "legendFormat": "{{alertname}} \u00b7 {{namespace}} \u00b7 {{alertstate}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Active",
                  "color": "red"
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "rowHeight": 0.8,
        "showValue": "never",
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 4,
      "title": "Current alerts",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{namespace=~\"$namespace\",alertname!~\"Watchdog|InfoInhibitor\"}",
          "legendFormat": "{{alertname}} \u00b7 {{namespace}} \u00b7 {{alertstate}}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "alertname": "Alert",
              "alertstate": "State",
              "namespace": "Namespace",
              "severity": "Severity"
            }
          }
        }
      ]
    }
  ]
}
