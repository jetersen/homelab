{
  "uid": "homelab-alerts",
  "title": "Homelab alerts",
  "tags": [
    "homelab",
    "alerts"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "title": "Alert rules",
      "type": "link",
      "url": "/alerting/list"
    },
    {
      "title": "Active notifications and silences",
      "type": "link",
      "url": "/alerting/notifications"
    },
    {
      "title": "Notification inbox",
      "type": "link",
      "url": "https://gotify.jetersen.dev"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "P4169E866C3094E38"
        },
        "query": "label_values(ALERTS, namespace)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "multi": false
      },
      {
        "name": "alert",
        "label": "Alert",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "P4169E866C3094E38"
        },
        "query": "label_values(ALERTS, alertname)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "multi": false
      },
      {
        "name": "history_state",
        "label": "History states",
        "type": "custom",
        "query": "Firing only : firing, Pending and firing : pending|firing",
        "current": {
          "text": "Firing only",
          "value": "firing"
        },
        "options": [
          {
            "text": "Firing only",
            "value": "firing",
            "selected": true
          },
          {
            "text": "Pending and firing",
            "value": "pending|firing",
            "selected": false
          }
        ],
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Firing alerts",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ALERTS{alertstate=\"firing\",namespace=~\"$namespace\",alertname=~\"$alert\",alertname!~\"Watchdog|InfoInhibitor\"}) or vector(0)",
          "legendFormat": "{{alertname}} \u00b7 {{namespace}} \u00b7 {{alertstate}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Pending alerts",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ALERTS{alertstate=\"pending\",namespace=~\"$namespace\",alertname=~\"$alert\",alertname!~\"Watchdog|InfoInhibitor\"}) or vector(0)",
          "legendFormat": "{{alertname}} \u00b7 {{namespace}} \u00b7 {{alertstate}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Alert state history",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (alertname, namespace, severity) ((ALERTS{namespace=~\"$namespace\",alertname=~\"$alert\",alertstate=~\"$history_state\",alertname!~\"Watchdog|InfoInhibitor\",alertstate=\"firing\"} * 2) or ALERTS{namespace=~\"$namespace\",alertname=~\"$alert\",alertstate=~\"$history_state\",alertname!~\"Watchdog|InfoInhibitor\",alertstate=\"pending\"})",
          "legendFormat": "{{alertname}} \u00b7 {{namespace}} \u00b7 {{severity}}",
          "instant": false,
          "range": true,
          "format": "time_series",
          "interval": "30s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 2,
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "axisWidth": 380,
            "spanNulls": false,
            "lineWidth": 0,
            "fillOpacity": 90
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Pending",
                  "color": "yellow"
                },
                "2": {
                  "text": "Firing",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "rowHeight": 0.8,
        "showValue": "never",
        "legend": {
          "showLegend": false
        },
        "perPage": 12,
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "One row per alert, namespace and severity. Shows the highest active state across instances: pending (yellow) or firing (red). Gaps mean no active state. Firing only by default; include pending with History states. Use Alert and Namespace to focus the history. Instance details are in Current alerts."
    },
    {
      "id": 4,
      "title": "Current alerts",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{namespace=~\"$namespace\",alertname=~\"$alert\",alertname!~\"Watchdog|InfoInhibitor\"}",
          "legendFormat": "{{alertname}} \u00b7 {{namespace}} \u00b7 {{alertstate}}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "alertname": "Alert",
              "alertstate": "State",
              "namespace": "Namespace",
              "severity": "Severity"
            }
          }
        }
      ]
    }
  ]
}
