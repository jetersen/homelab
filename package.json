{
  "name": "homelab",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "env:load": "varlock load --agent",
    "env:run": "varlock run -- fish -c 'eval (string escape -- $argv)' --",
    "check:javascript": "biome ci .",
    "format:javascript": "biome check --write .",
    "check:python": "ruff check . && ruff format --check .",
    "format:python": "ruff check --fix . && ruff format .",
    "check:csharp": "dotnet format Homelab.slnx --no-restore --verify-no-changes",
    "format:csharp": "dotnet format Homelab.slnx --no-restore"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jetersen/homelab.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/jetersen/homelab/issues"
  },
  "homepage": "https://github.com/jetersen/homelab#readme",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@varlock/proton-pass-plugin": "^2.0.0",
    "varlock": "^1.3.0"
  }
}
