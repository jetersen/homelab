{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automergeStrategy": "rebase",
  "extends": [
    "github>home-operations/renovate-presets",
    "github>jetersen/.github",
    "local>jetersen/homelab//.renovate/autoMerge.json5",
    "local>jetersen/homelab//.renovate/labels.json5",
    "local>jetersen/homelab//.renovate/versioning.json5",
    "local>jetersen/homelab//.renovate/groups.json5"
  ],
  "helm-values": {
    "managerFilePatterns": [
      "/^kubernetes/cluster/notifications/app/gotify\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "jsonata",
      "description": "Update TrueNAS catalog app versions consumed by Pulumi",
      "fileFormat": "json",
      "managerFilePatterns": [
        "/^infrastructure/truenas/catalog-apps\\.json$/"
      ],
      "matchStrings": [
        "$each($, function($app, $name) { {\"depName\": \"truenas/\" & $name, \"packageName\": $app.train & \"/\" & $name, \"currentValue\": $app.version} })"
      ],
      "datasourceTemplate": "custom.truenas-app",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the job image used by the Rocket Forgejo runner",
      "managerFilePatterns": [
        "/^infrastructure/forgejo/runner/rocket\\.yaml$/"
      ],
      "matchStrings": [
        "docker://(?<depName>forgejo\\.jetersen\\.dev/jetersen/homelab/runner-job):(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "TrueNAS SDK upgrades use GitHub release assets and a reviewed lockfile update",
      "matchDatasources": [
        "nuget"
      ],
      "matchPackageNames": [
        "Jetersen.Pulumi.TrueNas"
      ],
      "enabled": false
    },
    {
      "description": "GitHub Actions: prefer the latest update over separate major and minor PRs",
      "matchManagers": [
        "github-actions"
      ],
      "separateMajorMinor": false
    },
    {
      "description": "Update GitHub and Forgejo references to each GitHub action together",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "/^(https:\\/\\/github\\.com\\/)?[^/]+\\/[^/]+$/"
      ],
      "matchDepTypes": [
        "action"
      ],
      "groupName": "{{{packageName}}} action",
      "groupSlug": "{{{replace '/' '-' packageName}}}-action",
      "commitMessageTopic": "action {{{packageName}}}",
      "group": {
        "commitMessageTopic": "action {{{packageName}}}"
      },
      "prBodyDefinitions": {
        "Package": "[{{{packageName}}}](https://github.com/{{{packageName}}})"
      }
    }
  ],
  "customDatasources": {
    "truenas-app": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/truenas/apps/master/trains/{{packageName}}/app_versions.json",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": [$.*[healthy and supported].{\"version\": version}], \"sourceUrl\": \"https://github.com/truenas/apps\"}"
      ]
    }
  }
}
