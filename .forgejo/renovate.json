{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automergeStrategy": "fast-forward",
  "extends": [
    "github>home-operations/renovate-presets",
    "github>jetersen/.github",
    "local>jetersen/homelab//.renovate/autoMerge.json5",
    "local>jetersen/homelab//.renovate/labels.json5",
    "local>jetersen/homelab//.renovate/versioning.json5",
    "local>jetersen/homelab//.renovate/groups.json5"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the local-path-provisioner manifest fetched directly over HTTPS",
      "managerFilePatterns": [
        "/^kubernetes/cluster/local-path-provisioner/app/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/(?<depName>rancher/local-path-provisioner)/(?<currentValue>[^/]+)/deploy/local-path-storage\\.yaml"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "jsonata",
      "description": "Update TrueNAS catalog app versions consumed by Pulumi",
      "fileFormat": "json",
      "managerFilePatterns": [
        "/^infrastructure/truenas/catalog-apps\\.json$/"
      ],
      "matchStrings": [
        "$each($, function($app, $name) { {\"depName\": \"truenas/\" & $name, \"packageName\": $app.train & \"/\" & $name, \"currentValue\": $app.version} })"
      ],
      "datasourceTemplate": "custom.truenas-app",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "TrueNAS SDK upgrades use GitHub release assets and a reviewed lockfile update",
      "matchDatasources": [
        "nuget"
      ],
      "matchPackageNames": [
        "Jetersen.Pulumi.TrueNas"
      ],
      "enabled": false
    },
    {
      "description": "GitHub Actions: prefer the latest update over separate major and minor PRs",
      "matchManagers": [
        "github-actions"
      ],
      "separateMajorMinor": false
    },
    {
      "description": "Display GitHub action names without changing their Forgejo uses URLs",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "/^https:\\/\\/github\\.com\\//"
      ],
      "commitMessageTopic": "action {{{packageName}}}",
      "prBodyDefinitions": {
        "Package": "[{{{packageName}}}]({{{depName}}})"
      }
    }
  ],
  "customDatasources": {
    "truenas-app": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/truenas/apps/master/trains/{{packageName}}/app_versions.json",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": [$.*[healthy and supported].{\"version\": version}], \"sourceUrl\": \"https://github.com/truenas/apps\"}"
      ]
    }
  }
}
