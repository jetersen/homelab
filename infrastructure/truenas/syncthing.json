{
  "TZ": "Europe/Copenhagen",
  "labels": [],
  "network": {
    "certificate_id": null,
    "dns_opts": [],
    "host_network": false,
    "networks": [],
    "tcp_port": {
      "bind_mode": "published",
      "host_ips": [],
      "port_number": 20978
    },
    "udp_port": {
      "bind_mode": "published",
      "host_ips": [],
      "port_number": 20970
    },
    "web_port": {
      "bind_mode": "published",
      "host_ips": [],
      "port_number": 20910
    }
  },
  "release_name": "syncthing",
  "resources": {
    "limits": {
      "cpus": 2,
      "memory": 4096
    }
  },
  "run_as": {
    "group": 568,
    "user": 568
  },
  "storage": {
    "additional_storage": [
      {
        "host_path_config": {
          "acl_enable": false,
          "path": "/mnt/nvme/git"
        },
        "mount_path": "/mnt/nvme/git",
        "read_only": false,
        "type": "host_path"
      },
      {
        "host_path_config": {
          "acl_enable": false,
          "path": "/mnt/nvme/media/photos"
        },
        "mount_path": "/photos",
        "read_only": false,
        "type": "host_path"
      }
    ],
    "config": {
      "ix_volume_config": {
        "acl_enable": false,
        "dataset_name": "config"
      },
      "type": "ix_volume"
    }
  },
  "syncthing": {
    "additional_envs": []
  }
}
