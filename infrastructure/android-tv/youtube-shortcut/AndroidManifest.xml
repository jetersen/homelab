<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="tv.homelab.youtube">
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:label="YouTube" android:icon="@drawable/icon"
        android:banner="@drawable/banner" android:allowBackup="false"
        android:theme="@android:style/Theme.NoDisplay">
        <activity android:name=".OpenSubscriptions" android:exported="true"
            android:excludeFromRecents="true" android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
