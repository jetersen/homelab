[Unit]
Description=Private agent session search and archive
After=network-online.target agent-embeddings.service
Wants=agent-embeddings.service

[Service]
Type=simple
Environment=AGENTSVIEW_TELEMETRY_ENABLED=0
Environment=GOMEMLIMIT=1500MiB
Environment=AGENTSVIEW_DATA_DIR=/media/games/agent-observability/search
ExecStart=%h/.local/share/agent-observability/bin/agentsview serve --host 127.0.0.1 --port 8120 --no-browser --no-update-check --public-url https://rocket.rockhopper-bleak.ts.net --base-path /sessions
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
CPUWeight=20
IOWeight=20
MemoryHigh=2G
MemoryMax=4G

[Install]
WantedBy=default.target
