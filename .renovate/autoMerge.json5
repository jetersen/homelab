{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Use platform-native auto-merge for eligible updates, including images and charts.
  ignoreUnstable: true,
  automerge: true,
  automergeType: "pr",
  // Forgejo's plain rebase is named "fast-forward" in Renovate; "rebase" adds a merge commit.
  automergeStrategy: "fast-forward",
  platformAutomerge: true,
  // Forgejo's scheduled fast-forward merges cannot merge a diverged branch.
  rebaseWhen: "behind-base-branch",
  packageRules: [
    {
      description: "Prefer the newest eligible release instead of competing version PRs",
      matchPackageNames: ["*"],
      separateMajorMinor: false,
      separateMinorPatch: false,
      separateMultipleMajor: false,
      separateMultipleMinor: false,
    },
    {
      description: "Separate operating-system and Kubernetes patch updates from reviewed minor upgrades",
      matchPackageNames: ["siderolabs/talos", "ghcr.io/siderolabs/talos", "kubernetes/kubernetes", "ghcr.io/siderolabs/kubelet"],
      separateMajorMinor: true,
      separateMinorPatch: true,
      minimumReleaseAge: "3 days",
    },
    {
      description: "Talos and Kubernetes minor or major upgrades need explicit review",
      matchPackageNames: ["siderolabs/talos", "ghcr.io/siderolabs/talos", "kubernetes/kubernetes", "ghcr.io/siderolabs/kubelet"],
      matchUpdateTypes: ["major", "minor"],
      dependencyDashboardApproval: true,
      automerge: false,
    },
    {
      description: "GitHub Actions: wait out fresh releases",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "3 days",
    },
  ],
}
