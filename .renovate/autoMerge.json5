{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Use platform-native auto-merge by default; pace container and chart updates through Renovate.
  automerge: true,
  automergeType: "pr",
  automergeStrategy: "rebase",
  platformAutomerge: true,
  packageRules: [
    {
      description: "Pace container image and Helm chart upgrades through Renovate",
      matchDatasources: ["docker", "helm"],
      platformAutomerge: false,
      rebaseWhen: "behind-base-branch",
    },
    {
      description: "Separate operating-system and Kubernetes patch updates from reviewed minor upgrades",
      matchPackageNames: ["siderolabs/talos", "ghcr.io/siderolabs/talos", "kubernetes/kubernetes", "ghcr.io/siderolabs/kubelet"],
      separateMinorPatch: true,
      minimumReleaseAge: "3 days",
    },
    {
      description: "Talos and Kubernetes minor or major upgrades need explicit review",
      matchPackageNames: ["siderolabs/talos", "ghcr.io/siderolabs/talos", "kubernetes/kubernetes", "ghcr.io/siderolabs/kubelet"],
      matchUpdateTypes: ["major", "minor"],
      dependencyDashboardApproval: true,
      automerge: false,
    },
    {
      description: "GitHub Actions: wait out fresh releases",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "3 days",
    },
  ],
}
