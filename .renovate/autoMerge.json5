{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Use platform-native auto-merge for eligible updates, including images and charts.
  ignoreUnstable: true,
  automerge: true,
  minimumReleaseAge: "3 days",
  packageRules: [
    {
      description: "Prefer the newest eligible release instead of competing version PRs",
      matchPackageNames: ["*"],
      separateMajorMinor: false,
      separateMinorPatch: false,
      separateMultipleMajor: false,
      separateMultipleMinor: false,
    },
    {
      description: "Separate operating-system, Kubernetes, and Flux patches from reviewed minor upgrades",
      matchPackageNames: ["siderolabs/talos", "ghcr.io/siderolabs/talos", "kubernetes/kubernetes", "ghcr.io/siderolabs/kubelet", "controlplaneio-fluxcd/distribution"],
      separateMajorMinor: true,
      separateMinorPatch: true,
    },
    {
      description: "Talos, Kubernetes, and Flux minor or major upgrades need explicit review",
      matchPackageNames: ["siderolabs/talos", "ghcr.io/siderolabs/talos", "kubernetes/kubernetes", "ghcr.io/siderolabs/kubelet", "controlplaneio-fluxcd/distribution"],
      matchUpdateTypes: ["major", "minor"],
      dependencyDashboardApproval: true,
      automerge: false,
    },
  ],
}
